# --- Magento backend -------------------------------------------------------
# GraphQL endpoint of the Magento instance (docker-magento default).
PUBLIC_MAGENTO_GRAPHQL_ENDPOINT="https://magento.test/graphql"
# Public base URL of Magento, used to build media/image URLs when needed.
PUBLIC_MAGENTO_BASE_URL="https://magento.test/"
# Store view code sent as the `Store` header on every GraphQL request.
PUBLIC_MAGENTO_STORE_CODE="default"
# Currency used as a fallback before storeConfig is resolved.
PUBLIC_DEFAULT_CURRENCY="USD"

# --- Storefront ------------------------------------------------------------
# Canonical origin of this storefront (used for canonical tags + sitemap).
PUBLIC_SITE_URL="http://localhost:4321"

# --- Server-side cache (valkey/redis from the Magento compose stack) -------
REDIS_URL="redis://127.0.0.1:6379"
# Logical DB index — keep it away from the one Magento itself uses.
REDIS_DB="5"
# Default TTL (seconds) for cached GraphQL responses.
GRAPHQL_CACHE_TTL="300"
# Set to "false" to bypass the cache entirely (useful while debugging).
GRAPHQL_CACHE_ENABLED="true"

# --- Local TLS -------------------------------------------------------------
# docker-magento installs a self-signed certificate into the system trust
# store, which Node does not read by default. The npm scripts pass
# `--use-system-ca` on the command line (a NODE_OPTIONS entry in this file
# would be read too late to matter). If your certificate lives elsewhere, set
# NODE_EXTRA_CA_CERTS to its path instead of disabling verification:
# NODE_EXTRA_CA_CERTS="/path/to/nginx.crt"
