---
import Logo from '@/components/brand/Logo.astro';

interface Props {
  storeName?: string;
}
const { storeName = 'Mageless' } = Astro.props;
const year = new Date().getFullYear();

// Checkout lives in Magento, so these are the only destinations this
// storefront can honestly promise. Add your own once the routes exist.
const columns = [
  {
    title: 'Shop',
    links: [
      { label: 'All products', href: '/' },
      { label: 'Search', href: '/search' },
      { label: 'Cart', href: '/cart' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'Design system', href: '/design' },
      { label: 'Source on GitHub', href: 'https://github.com/JKrupinski/mageless' },
    ],
  },
];
---

<footer class="mt-section border-t border-line bg-surface">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo tagline="A headless storefront for Magento 2" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-muted">
        Server-rendered catalogue, faceted search and cart on Magento's GraphQL API. React islands
        only where interaction demands them — checkout stays in Magento.
      </p>
    </div>

    {
      columns.map((column) => (
        <nav aria-labelledby={`footer-${column.title.toLowerCase()}`}>
          <h2
            id={`footer-${column.title.toLowerCase()}`}
            class="text-xs font-semibold tracking-wider text-ink uppercase"
          >
            {column.title}
          </h2>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-muted transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="border-t border-line">
    <p class="container-page py-5 text-xs text-ink-muted">
      © {year}
      {storeName}
    </p>
  </div>
</footer>
