---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getStoreConfig } from '@lib/catalog';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** schema.org documents emitted as <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown>[];
  image?: string | null;
  noindex?: boolean;
  searchTerm?: string;
  /** Pages that own their gutter (a full-bleed hero) opt out of the container. */
  bleed?: boolean;
}

const {
  title,
  description = '',
  canonical,
  jsonLd = [],
  image = null,
  noindex = false,
  searchTerm = '',
  bleed = false,
} = Astro.props;

const store = await getStoreConfig().catch(() => ({
  storeName: 'Mageless',
  locale: 'en-US',
  currency: 'USD',
  titlePrefix: '',
  titleSuffix: '',
  defaultDescription: '',
  productUrlSuffix: '.html',
  categoryUrlSuffix: '.html',
  gridPerPage: 12,
}));

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const fullTitle = [store.titlePrefix, title, store.titleSuffix].filter(Boolean).join(' ');
const metaDescription = description || store.defaultDescription;
---

<!doctype html>
<html lang={store.locale.split('-')[0]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      /* The browser paints the address bar from this before any CSS loads, so
        both values are declared rather than derived from the theme tokens. */
    }
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#181a20" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    {
      /* Applies the stored theme before first paint. Inline and synchronous on
        purpose: deferring it would show one frame of the wrong theme. */
    }
    <script is:inline>
      try {
        const stored = localStorage.getItem('mageless:theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch {
        /* Private mode or blocked storage: fall back to the OS preference. */
      }
    </script>

    {
      jsonLd.map((document) => (
        <script type="application/ld+json" set:html={JSON.stringify(document)} />
      ))
    }
  </head>

  <body class="flex min-h-dvh flex-col bg-canvas text-ink">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header locale={store.locale} searchTerm={searchTerm} storeName={store.storeName} />
    <main id="main" class:list={['flex-1', bleed ? 'pb-16' : 'container-page py-8 sm:py-10']}>
      <slot />
    </main>
    <Footer storeName={store.storeName} />
  </body>
</html>
