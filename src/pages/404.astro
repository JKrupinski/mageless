---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="py-20 text-center">
    <p class="text-sm font-medium text-brand-700">404</p>
    <h1 class="mt-2 text-2xl font-semibold text-ink">We could not find that page</h1>
    <a
      href="/"
      class="mt-6 inline-block rounded-[--radius-control] bg-brand-600 px-4 py-2 text-sm font-medium text-white"
    >
      Back to the storefront
    </a>
  </div>
</BaseLayout>
