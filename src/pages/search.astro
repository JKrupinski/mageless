---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ProductGrid } from '@/components/product/ProductGrid';
import Pagination from '@/components/layout/Pagination.astro';
import { execute } from '@lib/graphql/client';
import { SearchQuery } from '@lib/graphql/queries/catalog';
import { SORT_OPTIONS, getStoreConfig, toSortInput } from '@lib/catalog';
import { searchSchema } from '@lib/cart/schemas';

const store = await getStoreConfig();
const rawTerm = Astro.url.searchParams.get('q') ?? '';
const currentPage = Math.max(1, Number(Astro.url.searchParams.get('p') ?? '1') || 1);
const sort = Astro.url.searchParams.get('sort') ?? 'relevance';

// The same Zod schema the search island uses, applied again on the server.
const parsed = searchSchema.safeParse({ q: rawTerm });
const term = parsed.success ? parsed.data.q : '';

const result = term
  ? await execute(SearchQuery, {
      variables: {
        search: term,
        sort: sort === 'relevance' ? { relevance: 'DESC' as const } : toSortInput(sort),
        pageSize: store.gridPerPage,
        currentPage,
      },
      cache: { ttl: 120 },
    })
  : null;

const totalCount = result?.products?.total_count ?? 0;
const totalPages = result?.products?.page_info?.total_pages ?? 1;

const buildHref = (page: number) => {
  const next = new URL(Astro.url.toString());
  if (page <= 1) next.searchParams.delete('p');
  else next.searchParams.set('p', String(page));
  return `${next.pathname}${next.search}`;
};

const sortHref = (value: string) => {
  const next = new URL(Astro.url.toString());
  if (value === 'relevance') next.searchParams.delete('sort');
  else next.searchParams.set('sort', value);
  next.searchParams.delete('p');
  return `${next.pathname}${next.search}`;
};
---

{/* Search result pages carry no index value and are kept out of the index. */}
<BaseLayout
  title={term ? `Search: ${term}` : 'Search'}
  description={term ? `Products matching “${term}”` : 'Search the catalogue'}
  noindex
  searchTerm={term}
>
  <header class="border-b border-line pb-6">
    <p class="text-xs font-semibold tracking-[0.14em] text-accent-text uppercase">Search</p>
    <h1 class="mt-3 text-display-md font-semibold text-ink">
      {term ? <>Results for “{term}”</> : 'Search the catalogue'}
    </h1>
    {
      !term && (
        <p class="mt-3 max-w-xl text-sm text-ink-muted">
          Type in the field at the top of the page. Suggestions appear as you type, and Enter opens
          the full result list.
        </p>
      )
    }
  </header>

  {
    !parsed.success && rawTerm.length > 0 && (
      <p
        role="alert"
        class="mt-4 rounded-control bg-danger-soft px-3 py-2 text-sm font-medium text-danger"
      >
        {parsed.error.issues[0]?.message}
      </p>
    )
  }

  {
    term && (
      <>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-line pb-3">
          <p class="numeric text-sm text-ink-muted" aria-live="polite">
            <span class="font-medium text-ink">{totalCount}</span>
            {totalCount === 1 ? ' product' : ' products'}
          </p>
          <nav aria-label="Sort by" class="-mx-1 flex min-w-0 items-center gap-1">
            <span class="shrink-0 px-1 text-sm text-ink-muted">Sort</span>
            <span class="hide-scrollbar flex gap-1 overflow-x-auto">
              {[
                { value: 'relevance', label: 'Relevance' },
                ...SORT_OPTIONS.filter((option) => option.value !== 'position'),
              ].map((option) => (
                <a
                  href={sortHref(option.value)}
                  rel="nofollow"
                  aria-current={sort === option.value ? 'true' : undefined}
                  class="inline-flex h-8 shrink-0 items-center rounded-control px-2.5 text-sm whitespace-nowrap text-ink-muted transition-colors hover:bg-surface-hover hover:text-ink aria-[current]:bg-ink aria-[current]:text-on-ink"
                >
                  {option.label}
                </a>
              ))}
            </span>
          </nav>
        </div>

        <ProductGrid
          className="mt-8"
          products={result?.products?.items ?? []}
          locale={store.locale}
          emptyMessage={`Nothing matched “${term}”`}
          emptyAction={{ label: 'Browse the storefront', href: '/' }}
        />

        <Pagination currentPage={currentPage} totalPages={totalPages} buildHref={buildHref} />
      </>
    )
  }
</BaseLayout>
