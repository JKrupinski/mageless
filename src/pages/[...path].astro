---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NotFound from '@/components/layout/NotFound.astro';
import ProductView from '@/components/catalog/ProductView.astro';
import CategoryView from '@/components/catalog/CategoryView.astro';
import { execute } from '@lib/graphql/client';
import {
  CategoryFeaturedQuery,
  CategoryPageQuery,
  ProductPageQuery,
  RouteQuery,
} from '@lib/graphql/queries/catalog';
import {
  FILTERABLE_ATTRIBUTES,
  buildProductFilters,
  getStoreConfig,
  toSortInput,
} from '@lib/catalog';
import { toProductViewModel, type ProductViewModel } from '@lib/viewmodels/product';
import {
  FEATURED_STRIP_SIZE,
  toCategoryViewModel,
  type CategoryViewModel,
} from '@lib/viewmodels/category';

/**
 * One catch-all route backed by Magento's own URL resolver.
 *
 * Every storefront URL keeps the exact shape Magento publishes
 * (`/women/tops-women.html`, `/erika-running-short.html`), so existing SEO,
 * redirects and backlinks survive the move to a headless frontend.
 */
/*
 * `Astro.params.path` drops a trailing `.html`, because Astro treats it as the
 * page extension. Magento's resolver needs the URL exactly as published,
 * suffix included, so the raw pathname is the source of truth here.
 */
const relativeUrl = decodeURIComponent(Astro.url.pathname).replace(/^\/+/, '');

if (!relativeUrl) return Astro.redirect('/', 302);

const store = await getStoreConfig();
const siteUrl = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, '');

const { route } = await execute(RouteQuery, {
  variables: { url: relativeUrl },
  cache: { ttl: 600 },
});

// Magento answers with a redirect code when a URL key has changed.
if (route?.redirect_code && route.relative_url && route.relative_url !== relativeUrl) {
  return Astro.redirect(`/${route.relative_url}`, route.redirect_code === 301 ? 301 : 302);
}

const isProduct = Boolean(route && route.type === 'PRODUCT' && 'url_key' in route);
const isCategory = Boolean(route && route.type === 'CATEGORY' && 'url_path' in route);

// --- Product ---------------------------------------------------------------
let product: ProductViewModel | null = null;
if (route && isProduct && 'url_key' in route && route.url_key) {
  const result = await execute(ProductPageQuery, {
    variables: { urlKey: route.url_key },
    cache: { ttl: 300 },
  });
  const item = result.products?.items?.[0];
  if (item) product = toProductViewModel(item, siteUrl);
}

// --- Category --------------------------------------------------------------
const currentPage = Math.max(1, Number(Astro.url.searchParams.get('p') ?? '1') || 1);
const sort = Astro.url.searchParams.get('sort') ?? 'position';
let category: CategoryViewModel | null = null;

if (route && isCategory && 'url_path' in route && route.url_path) {
  const urlPath = route.url_path;
  const filters = {
    category_url_path: { eq: urlPath },
    ...buildProductFilters(Astro.url.searchParams, FILTERABLE_ATTRIBUTES),
  };

  const result = await execute(CategoryPageQuery, {
    variables: {
      urlPath,
      filters,
      sort: toSortInput(sort),
      pageSize: store.gridPerPage,
      currentPage,
    },
    cache: { ttl: 180 },
  });

  const node = result.categories?.items?.[0];
  if (node) {
    category = await toCategoryViewModel(
      { node, products: result.products, siteUrl, url: Astro.url },
      {
        /*
         * A second round trip, and only on a Category Landing: the strip's
         * source is whichever descendant is busiest, which is not known until
         * the Category's own tree has come back.
         */
        async fetchFeatured(categoryUid) {
          const featured = await execute(CategoryFeaturedQuery, {
            variables: { categoryUid, pageSize: FEATURED_STRIP_SIZE },
            cache: { ttl: 300 },
          });
          return {
            totalCount: featured.products?.total_count ?? 0,
            products: featured.products?.items ?? [],
          };
        },
      },
    );
  }
}

const notFound = !product && !category;
if (notFound) Astro.response.status = 404;

// Filtered and paginated listings must not compete with the clean category URL
// in the search index.
const hasQuery = Astro.url.search.length > 0;
---

{
  product && (
    <BaseLayout
      title={product.seo.title}
      description={product.seo.description}
      image={product.seo.image}
      jsonLd={product.jsonLd}
    >
      <ProductView product={product} locale={store.locale} />
    </BaseLayout>
  )
}

{
  category && (
    <BaseLayout
      title={category.seo.title}
      description={category.seo.description}
      jsonLd={category.jsonLd}
      noindex={hasQuery}
      canonical={`${siteUrl}/${relativeUrl}`}
    >
      <CategoryView
        category={category}
        currentPage={currentPage}
        sort={sort}
        url={Astro.url}
        locale={store.locale}
      />
    </BaseLayout>
  )
}

{
  notFound && (
    <BaseLayout title="Page not found" noindex>
      <NotFound path={relativeUrl} />
    </BaseLayout>
  )
}
