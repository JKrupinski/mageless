---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ProductGrid } from '@/components/product/ProductGrid';
import CategoryTiles from '@/components/catalog/CategoryTiles.astro';
import { execute } from '@lib/graphql/client';
import { HomeQuery } from '@lib/graphql/queries/catalog';
import { getNavigation, getStoreConfig } from '@lib/catalog';
import { websiteJsonLd } from '@lib/seo/jsonld';

const [store, navigation] = await Promise.all([getStoreConfig(), getNavigation()]);

// Merchandise the busiest leaf category rather than hard-coding a category id.
// Anchor categories like "What's New" carry no directly-assigned products, so
// picking the first menu entry would render an empty row on a stock data set.
const featuredCategory =
  navigation
    .flatMap((item) => item.children)
    .sort((a, b) => (b.productCount ?? 0) - (a.productCount ?? 0))[0] ?? navigation[0];

const data = await execute(HomeQuery, {
  variables: { categoryUid: featuredCategory?.uid ?? '', pageSize: 8 },
  cache: { ttl: 300 },
});

const categories = (data.categories?.items ?? []).flatMap((category) =>
  category
    ? [
        {
          uid: category.uid,
          name: category.name ?? '',
          href: `/${category.url_path ?? ''}${category.url_suffix ?? ''}`,
          productCount: category.product_count ?? null,
        },
      ]
    : [],
);
const siteUrl = Astro.site?.toString() ?? Astro.url.origin;
const totalProducts = categories.reduce((sum, c) => sum + (c.productCount ?? 0), 0);
---

<BaseLayout
  title={store.storeName}
  description={store.defaultDescription || `Shop ${store.storeName}`}
  jsonLd={[websiteJsonLd(siteUrl.replace(/\/$/, ''), store.storeName)]}
>
  {
    /* An editorial masthead rather than a coloured hero panel. A full-bleed
      brand block is a wall of one colour before a shopper has seen a single
      product; setting the name in large type and letting the catalogue start
      immediately below puts the merchandise first, which is the whole point
      of a storefront. */
  }
  <section class="border-b border-line pb-10">
    <p class="text-xs font-semibold tracking-[0.14em] text-accent-text uppercase">
      {navigation.length > 0 ? `${navigation.length} departments` : 'Now open'}
    </p>
    <h1 class="mt-4 max-w-4xl text-display-lg font-semibold text-ink sm:text-display-xl">
      {store.storeName}
    </h1>
    <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <p class="max-w-xl text-base leading-relaxed text-ink-muted">
        {
          store.defaultDescription ||
            'A server-rendered catalogue on Magento GraphQL — faceted browsing, instant search and a cart that survives a reload.'
        }
      </p>
      {
        featuredCategory && (
          <a
            href={featuredCategory.href}
            class="inline-flex h-12 shrink-0 items-center gap-2 rounded-control bg-ink px-6 text-sm font-medium text-on-ink transition-colors hover:bg-ink-hover"
          >
            Shop {featuredCategory.name}
            <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )
      }
    </div>
  </section>

  {
    categories.length > 0 && (
      <section class="mt-section" aria-labelledby="shop-by-category">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="shop-by-category" class="text-display-sm font-semibold text-ink">
            Shop by category
          </h2>
          {totalProducts > 0 && (
            <p class="numeric text-sm text-ink-muted">{totalProducts} products</p>
          )}
        </div>

        <CategoryTiles class="mt-6" categories={categories} columns={6} />
      </section>
    )
  }

  {
    featuredCategory && (
      <section class="mt-section" aria-labelledby="featured">
        <div class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
          <h2 id="featured" class="text-display-sm font-semibold text-ink">
            {featuredCategory.name}
          </h2>
          <a
            href={featuredCategory.href}
            class="shrink-0 text-sm font-medium text-accent-text underline-offset-4 hover:underline"
          >
            View all {data.products?.total_count ?? 0}
            <span class="sr-only"> {featuredCategory.name} products</span>
          </a>
        </div>
        {/* Rendered on the server with zero client JavaScript. */}
        <ProductGrid
          className="mt-8"
          products={data.products?.items ?? []}
          locale={store.locale}
          priorityCount={4}
        />
      </section>
    )
  }
</BaseLayout>
