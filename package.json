{
  "name": "@headless-commerce/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca astro dev",
    "stop": "NODE_OPTIONS=--use-system-ca astro dev stop",
    "build": "NODE_OPTIONS=--use-system-ca astro build",
    "preview": "node --use-system-ca --env-file-if-exists=.env ./dist/server/entry.mjs",
    "astro": "astro",
    "schema:generate": "NODE_OPTIONS=--use-system-ca gql.tada generate schema \"${PUBLIC_MAGENTO_GRAPHQL_ENDPOINT:-https://magento.test/graphql}\" --output ./schema.graphql",
    "schema:turbo": "gql.tada turbo && gql.tada generate output",
    "typecheck": "NODE_OPTIONS=--use-system-ca astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "NODE_OPTIONS=--use-system-ca playwright test",
    "test:e2e:ui": "NODE_OPTIONS=--use-system-ca playwright test --ui",
    "test:a11y": "NODE_OPTIONS=--use-system-ca playwright test e2e/a11y.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@hookform/resolvers": "^5.2.2",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "gql.tada": "^1.11.3",
    "graphql": "^17.0.2",
    "ioredis": "^6.0.0",
    "nanostores": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "astro-eslint-parser": "^1.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
